{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mynote-s0-2-spike",
  "version": "0.1.0",
  "identifier": "dev.mynote.s02spike",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "my-note S0-2 Hotkey Spike",
        "width": 720,
        "height": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:19876"
    }
  }
}
