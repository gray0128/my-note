{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mynote-sync-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_DO",
        "class_name": "SyncJournalDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncJournalDO"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "mynote-archive"
    }
  ],
  "assets": {
    "directory": "../web/dist-pwa",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DAILY_ARCHIVE_INTERVAL_MS": "86400000",
    "PAIRING_TTL_MS": "600000",
    "T_GRACE_MIN_MS": "86400000",
    "SHRED_BATCH_LIMIT_24H": "20",
    "CLIP_MAX_ITEMS": "1000",
    "CLIP_TTL_MS": "2592000000",
    "CLIP_QUOTA_BYTES": "5368709120"
  }
}
